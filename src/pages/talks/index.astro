---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Talks | morita's website"
  description="morit958 の発表スライド一覧。"
  ogType="website"
  ogImage="/images/morit958.webp"
>
  <main class="page">
    <Header activePage="talks" />
    <div class="content-wrap">
      <div class="talks-heading">
        <div class="cmd-line">
          <span class="accent">$ </span>
          <span class="typed">ls slides/</span>
          <span class="caret"></span>
        </div>
      </div>
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .page {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .content-wrap {
    padding: 32px 36px 48px;
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
  }

  /* --- TalksHeading --- */
  .talks-heading {
    border-bottom: 1px solid var(--border);
    padding-bottom: 14px;
    margin-bottom: 24px;
  }

  .cmd-line {
    font-size: 22px;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.3px;
  }

  .accent {
    color: var(--accent);
  }

  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    animation: typing-talks 0.5s steps(10) forwards;
  }

  @keyframes typing-talks {
    from {
      width: 0ch;
    }
    to {
      width: 10ch;
    }
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    vertical-align: -0.12em;
    background: var(--fg);
    margin-left: 1px;
    animation:
      blink 1.05s steps(1) infinite,
      caret-hide-talks 0s 0.5s forwards;
  }

  @keyframes caret-hide-talks {
    to {
      opacity: 0;
      width: 0;
      margin: 0;
    }
  }

  @media (max-width: 640px) {
    .content-wrap {
      padding: 20px 16px 40px;
    }
  }
</style>
