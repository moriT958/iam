---
import { getCollection } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const allSlides = await getCollection(
  "slides",
  ({ data }) => import.meta.env.DEV || !data.draft,
);
const sorted = allSlides.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const processor = await createMarkdownProcessor();
const cards = await Promise.all(
  sorted.map(async (slide) => {
    const firstSlide = (slide.body ?? "").split(/\r?\n---\r?\n/)[0] ?? "";
    const { code } = await processor.render(firstSlide);
    return { slide, previewHtml: code };
  }),
);
---

<Layout
  title="Talks | morita's website"
  description="morit958 の発表スライド一覧。"
  ogType="website"
  ogImage="/images/morit958.webp"
>
  <main class="page">
    <Header activePage="talks" />
    <div class="content-wrap">
      <div class="talks-heading">
        <div class="cmd-line">
          <span class="accent">$ </span>
          <span class="typed">ls slides/</span>
          <span class="caret"></span>
        </div>
        <div class="subtitle">{sorted.length} slides</div>
      </div>

      <div class="grid">
        {
          cards.map(({ slide, previewHtml }) => {
            const dateStr = slide.data.date.toISOString().slice(0, 10);
            return (
              <a href={`/talks/${slide.id}`} class="card">
                <div class="preview" set:html={previewHtml} />
                <div class="meta">
                  <span class="title">{slide.data.title}</span>
                  <span class="date">{dateStr}</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .page {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .content-wrap {
    padding: 32px 36px 48px;
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
  }

  /* --- TalksHeading --- */
  .talks-heading {
    border-bottom: 1px solid var(--border);
    padding-bottom: 14px;
    margin-bottom: 24px;
  }

  .cmd-line {
    font-size: 22px;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.3px;
  }

  .accent {
    color: var(--accent);
  }

  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    animation: typing-talks 0.5s steps(10) forwards;
  }

  @keyframes typing-talks {
    from {
      width: 0ch;
    }
    to {
      width: 10ch;
    }
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    vertical-align: -0.12em;
    background: var(--fg);
    margin-left: 1px;
    animation:
      blink 1.05s steps(1) infinite,
      caret-hide-talks 0s 0.5s forwards;
  }

  @keyframes caret-hide-talks {
    to {
      opacity: 0;
      width: 0;
      margin: 0;
    }
  }

  .subtitle {
    color: var(--muted);
    font-size: 12px;
    margin-top: 4px;
    opacity: 0;
    animation: subtitle-fade-in-talks 0.3s ease 0.5s forwards;
  }

  @keyframes subtitle-fade-in-talks {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--panel);
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .preview {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #191919;
    color: #fff;
    font-family: sans-serif;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-size: 12px;
    pointer-events: none;
  }

  .preview :global(h1, h2, h3) {
    font-size: 1.6em;
    margin: 0 0 0.3em;
  }

  .preview :global(p) {
    margin: 0.2em 0;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 12px;
  }

  .title {
    font-size: 13px;
    color: var(--fg);
  }

  .date {
    font-size: 11px;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .content-wrap {
      padding: 20px 16px 40px;
    }
  }
</style>
