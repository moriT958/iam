---
import moonIconRaw from "../assets/moon-icon.svg?raw";
import sunIconRaw from "../assets/sun-icon.svg?raw";
import homeIconRaw from "../assets/home-icon.svg?raw";
import postsIconRaw from "../assets/posts-icon.svg?raw";
import talksIconRaw from "../assets/talks-icon.svg?raw";
import archivesIconRaw from "../assets/archives-icon.svg?raw";
import SearchModal from "./SearchModal.astro";

type Props = {
  activePage: "home" | "posts" | "archives" | "talks";
};

const { activePage } = Astro.props;
---

<header>
  <a href="/" class="brand">
    <span class="brand-icon">$</span>
    <span>morit958.com</span>
  </a>
  <div class="spacer"></div>
  <nav>
    <a href="/" class={activePage === "home" ? "nav-link active" : "nav-link"}
      >Home</a
    >
    <a
      href="/posts"
      class={activePage === "posts" ? "nav-link active" : "nav-link"}>Posts</a
    >
    <a
      href="/talks"
      class={activePage === "talks" ? "nav-link active" : "nav-link"}>Talks</a
    >
    <a
      href="/archives"
      class={activePage === "archives" ? "nav-link active" : "nav-link"}
      >Archives</a
    >
  </nav>
  <SearchModal />
  <button type="button" id="theme-toggle" aria-label="Switch theme">
    <span class="moon-icon" set:html={moonIconRaw} />
    <span class="sun-icon" set:html={sunIconRaw} />
  </button>
</header>

<nav class="mobile-bottom-bar">
  <a
    href="/"
    class={activePage === "home" ? "bottom-link active" : "bottom-link"}
    aria-current={activePage === "home" ? "page" : undefined}
  >
    <span class="bottom-link-icon" set:html={homeIconRaw} />
    <span class="bottom-link-label">Home</span>
  </a>
  <a
    href="/posts"
    class={activePage === "posts" ? "bottom-link active" : "bottom-link"}
    aria-current={activePage === "posts" ? "page" : undefined}
  >
    <span class="bottom-link-icon" set:html={postsIconRaw} />
    <span class="bottom-link-label">Posts</span>
  </a>
  <a
    href="/talks"
    class={activePage === "talks" ? "bottom-link active" : "bottom-link"}
    aria-current={activePage === "talks" ? "page" : undefined}
  >
    <span class="bottom-link-icon" set:html={talksIconRaw} />
    <span class="bottom-link-label">Talks</span>
  </a>
  <a
    href="/archives"
    class={activePage === "archives" ? "bottom-link active" : "bottom-link"}
    aria-current={activePage === "archives" ? "page" : undefined}
  >
    <span class="bottom-link-icon" set:html={archivesIconRaw} />
    <span class="bottom-link-label">Archives</span>
  </a>
</nav>

<script is:inline>
  const themeBtn = document.getElementById("theme-toggle");
  const COOKIE = "var-card-theme";

  themeBtn.addEventListener("click", () => {
    const current = document.documentElement.dataset.theme ?? "light";
    const next = current === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    document.cookie = `${COOKIE}=${next}; Path=/; Max-Age=31536000; SameSite=Lax`;
  });
</script>

<style>
  header {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 10px 20px;
    border: 1px solid var(--border);
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 999px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 6px 20px -10px rgba(0, 0, 0, 0.12);
    position: sticky;
    top: 16px;
    z-index: 100;
    width: calc(100% - 32px);
    max-width: 860px;
    margin: 16px auto 0;
  }

  .brand {
    text-decoration: none;
    color: var(--fg);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.3px;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .brand-icon {
    color: var(--accent);
  }

  header nav {
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    border: 1px solid var(--border);
  }

  .nav-link {
    color: var(--muted);
    font-size: 13px;
    padding: 6px 14px;
    border-radius: 999px;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--fg);
  }

  .nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .spacer {
    flex: 1;
  }

  #theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 999px;
    width: 34px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  #theme-toggle:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .moon-icon {
    display: inline-flex;
  }

  .sun-icon {
    display: none;
  }

  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }

  :global([data-theme="dark"]) .sun-icon {
    display: inline-flex;
  }

  /* mobile bottom bar */
  .mobile-bottom-bar {
    display: none;
  }

  @media (max-width: 640px) {
    header {
      padding: 8px 8px 8px 20px;
      gap: 10px;
    }

    header nav {
      display: none;
    }

    .mobile-bottom-bar {
      display: flex;
      align-items: stretch;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 100;
      border-top: 1px solid var(--border);
      background: var(--bg);
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding-bottom: env(safe-area-inset-bottom);
    }

    .bottom-link {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 8px 0 6px;
      color: var(--muted);
      text-decoration: none;
    }

    .bottom-link-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px 18px;
      border-radius: 999px;
    }

    .bottom-link-icon svg {
      display: block;
    }

    .bottom-link-label {
      font-size: 10px;
      line-height: 1;
    }

    .bottom-link.active .bottom-link-icon {
      color: var(--accent);
      background: var(--accent-soft);
    }

    .bottom-link.active .bottom-link-label {
      color: var(--accent);
      font-weight: 600;
    }

    :global(body) {
      padding-bottom: calc(60px + env(safe-area-inset-bottom));
    }
  }
</style>
